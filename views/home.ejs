<%- include('partials/head') %>
<% const w = site.wedding; const pg = (site.pages && site.pages.home) || {}; const firstHotel = (site.travel.hotels || [])[0]; %>
<section class="hero">
  <div class="hero__text">
    <p class="eyebrow reveal"><%= site.hero.eyebrow %></p>
    <h1 class="hero__names reveal">
      <span><%= site.couple.partner1.first %></span>
      <span class="amp">&amp;</span>
      <span><%= site.couple.partner2.first %></span>
    </h1>
    <div class="rule reveal"></div>
    <p class="hero__date reveal"><%= fmt.longDate(w.start) %></p>
    <p class="hero__place reveal"><%= w.venue %> · <%= w.cityLine %></p>
    <div class="countdown reveal" id="countdown" data-date="<%= w.start %>" hidden>
      <div><b data-unit="days">0</b><span>days</span></div>
      <div><b data-unit="hours">0</b><span>hours</span></div>
      <div><b data-unit="minutes">0</b><span>minutes</span></div>
    </div>
    <div class="hero__actions reveal">
      <a class="btn" href="/rsvp">RSVP</a>
      <a class="btn btn--ghost" href="/schedule">The weekend</a>
    </div>
  </div>
  <div class="hero__media reveal">
    <%- include('partials/photo', { src: site.hero.image, alt: site.hero.imageAlt, cls: 'photo--hero', label: fmt.monogram(), eager: true }) %>
  </div>
</section>

<section class="section section--alt">
  <div class="wrap">
    <p class="eyebrow center reveal">The day</p>
    <h2 class="h2 center reveal"><%= pg.dayHeading || `${fmt.dayDate(w.start).split(',')[0]} at ${w.venue}` %></h2>
    <div class="details reveal">
      <% const ceremony = fmt.eventByKey('ceremony') || site.schedule[0]; const reception = fmt.eventByKey('reception'); %>
      <div class="detail">
        <span class="detail__label">Ceremony</span>
        <span class="detail__big"><%= fmt.time(ceremony.start) %></span>
        <span class="detail__sub"><%= ceremony.venue %></span>
      </div>
      <% if (reception) { %>
      <div class="detail">
        <span class="detail__label">Reception</span>
        <span class="detail__big"><%= fmt.time(reception.start) %></span>
        <span class="detail__sub"><%= reception.venue %></span>
      </div>
      <% } %>
      <div class="detail">
        <span class="detail__label">Dress</span>
        <span class="detail__big"><%= ceremony.dress %></span>
        <% if (pg.dressNote) { %><span class="detail__sub"><%= pg.dressNote %></span><% } %>
      </div>
    </div>
    <div class="actions center reveal">
      <a class="btn btn--outline" href="/calendar.ics">Add to calendar</a>
      <a class="btn btn--ghost" href="<%= fmt.mapsUrl(w.mapsQuery) %>" target="_blank" rel="noopener">Directions ↗</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap wrap--narrow center">
    <p class="eyebrow reveal">How we got here</p>
    <h2 class="h2 reveal"><%= site.story.intro %></h2>
    <a class="link reveal" href="/story">Read our story</a>
  </div>
</section>

<section class="strip reveal">
  <% for (const p of site.photos.slice(0, 3)) { %>
    <%- include('partials/photo', { src: p.src, alt: p.alt, cls: 'photo--strip', label: '' }) %>
  <% } %>
</section>

<% if (site.travel && site.travel.hotels && site.travel.hotels.length) { %>
<section class="section section--alt">
  <div class="wrap wrap--narrow center">
    <p class="eyebrow reveal">Where to stay</p>
    <h2 class="h2 reveal"><%= pg.stayHeading || 'Where to stay' %></h2>
    <p class="body reveal"><%= pg.stayText || 'Hotel blocks and travel details are on the travel page.' %><% if (firstHotel && firstHotel.deadline) { %> Rates hold until <%= fmt.dateOnly(firstHotel.deadline) %>.<% } %></p>
    <a class="link reveal" href="/travel">Travel &amp; accommodations</a>
  </div>
</section>
<% } %>

<section class="cta">
  <div class="wrap center">
    <p class="eyebrow reveal">Kindly reply by <%= fmt.dateOnly(site.rsvp.deadline) %></p>
    <h2 class="display reveal"><%= (site.pages && site.pages.rsvp && site.pages.rsvp.heading) || 'Will you join us?' %></h2>
    <a class="btn reveal" href="/rsvp">RSVP</a>
  </div>
</section>
<%- include('partials/foot') %>
