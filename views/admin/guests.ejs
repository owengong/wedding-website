<%- include('_head') %>
<div class="head">
  <h1>Guests <span class="muted">(<%= households.length %> households)</span></h1>
  <a class="btn" href="/admin/households/new">Add household</a>
</div>
<% if (flash) { %><p class="flash"><%= flash %></p><% } %>

<form class="filters" method="get" action="/admin/guests">
  <input class="input" type="search" name="q" value="<%= q %>" placeholder="Search names">
  <select class="input" name="status">
    <option value="" <%= status === '' ? 'selected' : '' %>>All</option>
    <option value="responded" <%= status === 'responded' ? 'selected' : '' %>>Responded</option>
    <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Pending</option>
  </select>
  <button class="btn btn--ghost" type="submit">Filter</button>
</form>

<section class="card card--flush">
  <table class="table table--guests">
    <thead>
      <tr>
        <th>Household</th>
        <th>Guest</th>
        <% for (const e of events) { %><th><%= e.name %></th><% } %>
        <th>Entrée</th>
        <th>Notes</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (!households.length) { %><tr><td colspan="<%= 5 + events.length %>" class="muted center">No households match.</td></tr><% } %>
      <% for (const h of households) { %>
        <% h.guests.forEach((g, i) => { %>
          <tr class="<%= i === 0 ? 'first' : '' %>">
            <% if (i === 0) { %>
              <td rowspan="<%= h.guests.length %>" class="hh">
                <a href="/admin/households/<%= h.id %>"><b><%= h.name %></b></a>
                <div class="muted small">
                  <%= h.responded_at ? `Replied ${h.responded_at.slice(0, 10)}` : 'No reply yet' %>
                  <% if (h.plus_ones) { %> · +<%= h.plus_ones %><% } %>
                  <% if (!h.invited_all) { %> · <%= h.invited_events.join(', ') %><% } %>
                </div>
                <% if (h.email) { %><div class="small"><a href="mailto:<%= h.email %>"><%= h.email %></a></div><% } %>
                <% if (h.song_request || h.message) { %><div class="small muted"><% if (h.song_request) { %>♪ <%= h.song_request %><br><% } %><%= h.message || '' %></div><% } %>
              </td>
            <% } %>
            <td><%= g.first_name %> <%= g.last_name %><% if (g.is_plus_one) { %> <span class="pill pill--muted">guest</span><% } %></td>
            <% for (const e of events) { const a = g.rsvps[e.key]; const invited = h.invited_events.includes(e.key); %>
              <td><% if (!invited) { %><span class="muted">·</span><% } else if (a === 1) { %><span class="pill pill--yes">Yes</span><% } else if (a === 0) { %><span class="pill pill--no">No</span><% } else { %><span class="pill">—</span><% } %></td>
            <% } %>
            <td class="small"><%= g.meal || '' %></td>
            <td class="small muted"><%= g.dietary || '' %></td>
            <% if (i === 0) { %>
              <td rowspan="<%= h.guests.length %>" class="actions">
                <a href="/admin/households/<%= h.id %>">Edit</a>
                <a href="/rsvp/<%= h.code %>" target="_blank" rel="noopener" title="Guest RSVP link">RSVP ↗</a>
              </td>
            <% } %>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</section>
<%- include('_foot') %>
