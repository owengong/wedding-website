<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? `${title} · ` : '' %><%= fmt.coupleNames() %></title>
<meta name="description" content="<%= fmt.coupleNames() %> are getting married on <%= fmt.longDate(site.wedding.start) %>.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css?v=<%= v %>">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='16' fill='%236F7F67'/><text x='16' y='21' text-anchor='middle' font-family='Georgia,serif' font-size='14' fill='%23F8F6F1'><%= fmt.monogram() %></text></svg>">
</head>
<body class="page-<%= page %>">
<a class="skip" href="#main">Skip to content</a>
<header class="nav" id="nav">
  <a class="nav__brand" href="/" aria-label="Home"><%= fmt.monogram().split('').join(' & ') %></a>
  <button class="nav__toggle" id="navToggle" aria-expanded="false" aria-controls="navMenu" aria-label="Menu">
    <span></span><span></span>
  </button>
  <nav class="nav__menu" id="navMenu">
    <ul>
      <% const links = [['/story','Our Story'],['/party','Wedding Party'],['/schedule','Schedule'],['/travel','Travel'],['/registry','Registry'],['/faq','Q&A'],['/photos','Photos']]; %>
      <% for (const [href, label] of links) { const key = href.slice(1); %>
        <li><a href="<%= href %>" <%= page === key ? 'aria-current="page"' : '' %>><%= label %></a></li>
      <% } %>
      <li class="nav__cta"><a href="/rsvp" class="btn btn--outline btn--sm" <%= page === 'rsvp' ? 'aria-current="page"' : '' %>>RSVP</a></li>
    </ul>
  </nav>
</header>
<main id="main">
