<%- include('partials/head') %>
<div class="wrap">
  <%- include('partials/page-hero', { eyebrow: 'Wedding party', heading: (site.pages && site.pages.party && site.pages.party.heading) || 'The people standing with us' }) %>
  <% const sides = [site.couple.partner1.first, site.couple.partner2.first]; %>
  <% for (const side of sides) { const people = site.party.filter(p => p.side === side); if (!people.length) continue; %>
    <h2 class="eyebrow eyebrow--section reveal">With <%= side %></h2>
    <ul class="people">
      <% for (const p of people) { %>
        <li class="person reveal">
          <%- include('partials/photo', { src: p.image || '', alt: p.name, cls: 'photo--arch', label: fmt.initials(p.name) }) %>
          <h3 class="person__name"><%= p.name %></h3>
          <p class="person__role"><%= p.role %></p>
          <% if (p.bio) { %><p class="person__bio"><%= p.bio %></p><% } %>
        </li>
      <% } %>
    </ul>
  <% } %>
</div>
<%- include('partials/foot') %>
